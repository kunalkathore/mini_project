<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PackMatch – Designers × Print Shops</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --red: #E63946;
            --off-white: #F8F7F4;
            --dark: #1a1a1a;
            --gray: #6b6b6b;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Georgia', serif;
            background: var(--off-white);
            color: var(--dark);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* Typography */
        h1 {
            font-size: clamp(2.5rem, 8vw, 5rem);
            font-weight: 900;
            letter-spacing: -0.02em;
            line-height: 1.1;
            margin-bottom: 1.5rem;
        }

        h2 {
            font-size: clamp(1.8rem, 5vw, 3rem);
            font-weight: 800;
            letter-spacing: -0.01em;
            margin-bottom: 2rem;
        }

        h3 {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 0.8rem;
        }

        p {
            font-size: 1rem;
            color: var(--gray);
            margin-bottom: 1.2rem;
        }

        /* Nav */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.5rem 2rem;
            background: var(--off-white);
            border-bottom: 1px solid rgba(230, 57, 70, 0.1);
            z-index: 1000;
            backdrop-filter: blur(8px);
        }

        .logo {
            font-size: 1.2rem;
            font-weight: 900;
            letter-spacing: -0.03em;
            color: var(--red);
            text-decoration: none;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 2rem;
        }

        nav a {
            text-decoration: none;
            color: var(--dark);
            font-size: 0.9rem;
            font-weight: 600;
            position: relative;
            transition: color 0.3s;
        }

        nav a::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--red);
            transition: width 0.3s;
        }

        nav a:hover::after {
            width: 100%;
        }

        /* Hero */
        .hero {
            margin-top: 80px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-start;
            padding: 4rem 2rem;
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }

        .hero h1 {
            max-width: 90%;
            animation: fadeInUp 0.8s ease-out;
        }

        .hero .subheadline {
            font-size: 1.3rem;
            max-width: 600px;
            margin-bottom: 2.5rem;
            animation: fadeInUp 0.8s ease-out 0.1s both;
        }

        .cta-button {
            display: inline-block;
            padding: 1rem 2.5rem;
            background: var(--red);
            color: var(--off-white);
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            animation: fadeInUp 0.8s ease-out 0.2s both;
        }

        .cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: var(--dark);
            transition: left 0.3s;
            z-index: -1;
        }

        .cta-button:hover {
            transform: translateY(-3px);
        }

        .cta-button:active {
            transform: translateY(-1px);
        }

        /* Sections */
        section {
            padding: 6rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        section h2 {
            text-align: center;
            margin-bottom: 4rem;
            position: relative;
            display: inline-block;
            width: 100%;
        }

        section h2::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: var(--red);
        }

        /* Features */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 3rem;
            margin-top: 3rem;
        }

        .feature {
            opacity: 0;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .feature:nth-child(1) { animation-delay: 0.1s; }
        .feature:nth-child(2) { animation-delay: 0.2s; }
        .feature:nth-child(3) { animation-delay: 0.3s; }

        .feature-icon {
            width: 50px;
            height: 50px;
            margin-bottom: 1.5rem;
            padding: 12px;
            background: rgba(230, 57, 70, 0.1);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
        }

        .feature:hover .feature-icon {
            background: var(--red);
        }

        .feature:hover .feature-icon svg {
            stroke: var(--off-white);
        }

        .feature svg {
            stroke: var(--red);
            transition: stroke 0.3s;
        }

        .feature h3 {
            color: var(--dark);
        }

        /* Steps */
        .steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .step {
            padding: 2rem;
            border-left: 3px solid var(--red);
            opacity: 0;
            animation: fadeInUp 0.6s ease-out forwards;
        }

        .step:nth-child(1) { animation-delay: 0.1s; }
        .step:nth-child(2) { animation-delay: 0.2s; }
        .step:nth-child(3) { animation-delay: 0.3s; }

        .step-number {
            font-size: 2.5rem;
            font-weight: 900;
            color: var(--red);
            margin-bottom: 0.5rem;
        }

        /* Footer */
        footer {
            background: var(--dark);
            color: var(--off-white);
            padding: 3rem 2rem;
            text-align: center;
            border-top: 2px solid var(--red);
        }

        footer p {
            color: rgba(248, 247, 244, 0.7);
            margin-bottom: 0.5rem;
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Scroll animations */
        .scroll-animate {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.6s ease-out, transform 0.6s ease-out;
        }

        .scroll-animate.in-view {
            opacity: 1;
            transform: translateY(0);
        }

        /* Responsive */
        @media (max-width: 768px) {
            nav ul {
                gap: 1rem;
                font-size: 0.8rem;
            }

            .hero {
                margin-top: 100px;
                padding: 2rem 1.5rem;
            }

            section {
                padding: 4rem 1.5rem;
            }

            h1 {
                font-size: 2.5rem;
            }

            h2 {
                font-size: 1.8rem;
            }
        }

        @media (max-width: 480px) {
            nav {
                padding: 1rem;
            }

            .logo {
                font-size: 1rem;
            }

            nav ul {
                gap: 0.8rem;
                font-size: 0.7rem;
            }

            .hero {
                margin-top: 80px;
            }

            .hero h1 {
                max-width: 100%;
            }

            h1 {
                font-size: 2rem;
            }

            h2 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav>
        <a href="#" class="logo">PackMatch</a>
        <ul>
            <li><a href="#features">Features</a></li>
            <li><a href="#how-it-works">How It Works</a></li>
            <li><a href="#footer">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Design Meets Purpose.<br><span style="color: var(--red);">Packaging Gets Sustainable.</span></h1>
        <p class="subheadline">Connect talented freelance designers with local print shops hungry for fresh creative energy. Build beautiful, sustainable packaging. Get paid fairly. No middlemen.</p>
        <button class="cta-button">Start Creating Today</button>
    </section>

    <!-- Features Section -->
    <section id="features">
        <h2>Why PackMatch</h2>
        <div class="features">
            <div class="feature">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/>
                    </svg>
                </div>
                <h3>Human-First Matching</h3>
                <p>We pair designers with shops based on style, values, and vision—not algorithms. Real connections. Real work.</p>
            </div>

            <div class="feature">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </div>
                <h3>Eco-Conscious</h3>
                <p>Every project emphasizes sustainable materials, minimal waste, and responsible production practices.</p>
            </div>

            <div class="feature">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="1"/>
                        <path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m5.08 5.08l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m5.08-5.08l4.24-4.24"/>
                    </svg>
                </div>
                <h3>Fair Economics</h3>
                <p>Direct relationships mean designers earn more, shops get quality work faster, and margins stay healthy.</p>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section id="how-it-works">
        <h2>How It Works</h2>
        <div class="steps">
            <div class="step scroll-animate">
                <div class="step-number">01</div>
                <h3>Sign Up & Profile</h3>
                <p>Designers showcase portfolios; print shops list current needs and design philosophy. Tell us what matters.</p>
            </div>

            <div class="step scroll-animate">
                <div class="step-number">02</div>
                <h3>Get Matched</h3>
                <p>Our team connects you with partners whose values and aesthetics align. No cold outreach. Just warm introductions.</p>
            </div>

            <div class="step scroll-animate">
                <div class="step-number">03</div>
                <h3>Collaborate & Deliver</h3>
                <p>Work directly together. Design, iterate, print sustainably, and ship with confidence. We're here if you need us.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer id="footer">
        <p><strong>PackMatch</strong> — Connecting Design Talent with Purpose-Driven Print.</p>
        <p>© 2024. Built for the future of sustainable packaging.</p>
    </footer>

    <script>
        // Smooth scroll for nav links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const href = this.getAttribute('href');
                if (href !== '#') {
                    e.preventDefault();
                    const target = document.querySelector(href);
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            });
        });

        // Scroll animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('in-view');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('.scroll-animate').forEach(el => {
            observer.observe(el);
        });

        // CTA button interaction
        document.querySelector('.cta-button').addEventListener('click', function() {
            alert('Welcome to PackMatch! Feature coming soon.');
        });

        // Subtle mouse follow on hero
        const hero = document.querySelector('.hero');
        if (hero) {
            document.addEventListener('mousemove', (e) => {
                const x = (e.clientX / window.innerWidth) * 0.5;
                const y = (e.clientY / window.innerHeight) * 0.5;
                hero.style.backgroundPosition = `${x}% ${y}%`;
            });
        }
    </script>
</body>
</html>
